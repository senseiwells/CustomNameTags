{
  "schemaVersion": 1,
  "id": "nametag",
  "version": "${version}",
  "name": "Custom Nametags",
  "description": "This mod provides you with a way to customize your player's name tags completely server-side with no need for any client mods.",
  "authors": [
    "Sensei"
  ],
  "contact": {
    "sources": "https://github.com/senseiwells/CustomNameTags"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "me.senseiwells.nametag.CustomNameTags"
      }
    ]
  },
  "mixins": [
    "nametag.mixins.json"
  ],
  "depends": {
    "fabric": "*",
    "fabricloader": ">=${fabric_loader_dependency}",
    "fabric-language-kotlin": ">=${fabric_kotlin_dependency}",
    "minecraft": "${minecraft_dependency}",
    "polymer-core": ">=${polymer_dependency}",
    "polymer-virtual-entity": ">=${polymer_dependency}",
    "placeholder-api": ">=${placeholder_dependency}"
  }
}
